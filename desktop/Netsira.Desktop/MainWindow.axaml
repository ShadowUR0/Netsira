<Window
    x:Class="Netsira.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:u="https://irihi.tech/ursa"
    Title="Netsira"
    Width="1180"
    Height="780"
    MinWidth="900"
    MinHeight="620">

    <Grid ColumnDefinitions="Auto,*" Background="{DynamicResource SemiColorBg0}">
        <Border
            Grid.Column="0"
            Margin="12"
            Padding="6"
            Theme="{DynamicResource CardBorder}">
            <u:NavMenu
                x:Name="AppNavMenu"
                ExpandWidth="228"
                CollapseWidth="64"
                SelectionChanged="OnNavSelectionChanged">
                <u:NavMenu.Header>
                    <StackPanel Margin="10,14,10,18">
                        <TextBlock FontSize="22" FontWeight="Bold" Text="Netsira" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource SemiColorText2}"
                            Text="Network diagnostics" />
                    </StackPanel>
                </u:NavMenu.Header>

                <u:NavMenuItem x:Name="DiagnosticsNavItem" Header="Diagnostics">
                    <u:NavMenuItem.Icon>
                        <TextBlock Text="●" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem x:Name="DevicesNavItem" Header="Devices">
                    <u:NavMenuItem.Icon>
                        <TextBlock Text="◉" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem x:Name="CalculatorsNavItem" Header="Calculators">
                    <u:NavMenuItem.Icon>
                        <TextBlock Text="∑" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem x:Name="HistoryNavItem" Header="History">
                    <u:NavMenuItem.Icon>
                        <TextBlock Text="↺" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>
                <u:NavMenuItem x:Name="SettingsNavItem" Header="Settings">
                    <u:NavMenuItem.Icon>
                        <TextBlock Text="⚙" />
                    </u:NavMenuItem.Icon>
                </u:NavMenuItem>

                <u:NavMenu.Footer>
                    <StackPanel Margin="10,16">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource SemiColorText2}"
                            Text="Local-first · no telemetry" />
                    </StackPanel>
                </u:NavMenu.Footer>
            </u:NavMenu>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer x:Name="DiagnosticsPage">
                <StackPanel Margin="18,18,28,32" Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock
                                FontSize="12"
                                FontWeight="Bold"
                                Foreground="{DynamicResource SemiBlue5}"
                                Text="NETWORK HEALTH" />
                            <TextBlock Margin="0,3,0,0" FontSize="34" FontWeight="Bold" Text="Diagnostics" />
                            <TextBlock
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource SemiColorText2}"
                                Text="Start with a quick check. Open deeper tests only when you need them." />
                        </StackPanel>
                        <Button
                            x:Name="ExportReportButton"
                            Grid.Column="1"
                            VerticalAlignment="Top"
                            IsEnabled="False"
                            Click="ExportReport"
                            Content="Export report" />
                    </Grid>

                    <Border Padding="22" Theme="{DynamicResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                            <StackPanel>
                                <TextBlock
                                    x:Name="OverallStatus"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource SemiBlue5}"
                                    Text="Not tested" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="24"
                                    FontWeight="Bold"
                                    Text="Run a quick check to see what is healthy." />
                                <TextBlock
                                    x:Name="QuickTestStatus"
                                    Margin="0,8,0,0"
                                    MaxWidth="680"
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    Text="Netsira checks network reachability, DNS, latency and loss first." />
                            </StackPanel>
                            <Button
                                x:Name="QuickTestButton"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                MinWidth="150"
                                MinHeight="44"
                                Click="RunQuickTest"
                                Content="Run quick check" />
                        </Grid>
                    </Border>

                    <Border Padding="18" Theme="{DynamicResource CardBorder}">
                        <Grid ColumnDefinitions="*,28,*,28,*">
                            <StackPanel>
                                <TextBlock FontWeight="Bold" Text="Computer" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Ready" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Text="→" />
                            <StackPanel Grid.Column="2">
                                <TextBlock FontWeight="Bold" Text="Network" />
                                <TextBlock x:Name="PathNetworkState" FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Not tested" />
                            </StackPanel>
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Text="→" />
                            <StackPanel Grid.Column="4">
                                <TextBlock FontWeight="Bold" Text="Internet" />
                                <TextBlock x:Name="PathInternetState" FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Not tested" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                        <Border Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="INTERNET" />
                                <TextBlock x:Name="InternetMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="InternetHealthBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Reachability / latency" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="LOSS" />
                                <TextBlock x:Name="LossMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="LossHealthBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Successful probes" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="DOWNLOAD" />
                                <TextBlock x:Name="DownloadMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Mb/s" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="STABILITY" />
                                <TextBlock x:Name="StabilityMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="StabilityHealthBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Successful probes" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="20" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="19" FontWeight="Bold" Text="What Netsira found" />
                            <TextBlock
                                Foreground="{DynamicResource SemiColorText2}"
                                Text="Important findings first; raw measurements stay secondary." />
                            <TextBlock
                                x:Name="DeviceFindingStatus"
                                TextWrapping="Wrap"
                                Text="No test results yet." />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*">
                        <Border Padding="20" Theme="{DynamicResource CardBorder}">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Stability · 30 seconds" />
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    Text="Repeated reachability checks. airOS signal is sampled too when device credentials are available." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="StabilityStartButton"
                                        Click="StartStability"
                                        Content="Run stability test" />
                                    <Button
                                        x:Name="StabilityStopButton"
                                        IsEnabled="False"
                                        Click="StopStability"
                                        Content="Cancel" />
                                </StackPanel>
                                <TextBlock x:Name="StabilityStatus" TextWrapping="Wrap" Text="Not run yet." />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Padding="20" Theme="{DynamicResource CardBorder}">
                            <StackPanel Spacing="10">
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Internet speed" />
                                <TextBlock
                                    TextWrapping="Wrap"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    Text="Optional M-Lab throughput test. Measurement metadata includes your public IP." />
                                <CheckBox
                                    x:Name="MlabConsent"
                                    Content="I understand the M-Lab privacy notice" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        x:Name="SpeedTestButton"
                                        Click="RunSpeedTest"
                                        Content="Speed test" />
                                    <Button
                                        x:Name="StandardTestButton"
                                        Click="RunStandardTest"
                                        Content="Standard" />
                                </StackPanel>
                                <TextBlock x:Name="SpeedTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                                <TextBlock x:Name="ModeTestStatus" TextWrapping="Wrap" Foreground="{DynamicResource SemiColorText2}" Text="Not run yet." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="20" Theme="{DynamicResource CardBorder}">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel>
                                <TextBlock FontSize="18" FontWeight="Bold" Text="Comprehensive test" />
                                <TextBlock
                                    Margin="0,5,0,0"
                                    Foreground="{DynamicResource SemiColorText2}"
                                    Text="Combines internet diagnostics with airOS device status when credentials are available." />
                            </StackPanel>
                            <Button
                                x:Name="ComprehensiveTestButton"
                                Grid.Column="1"
                                Click="RunComprehensiveTest"
                                Content="Run comprehensive" />
                        </Grid>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="DevicesPage" IsVisible="False">
                <StackPanel Margin="18,18,28,32" Spacing="16">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SemiBlue5}" Text="LOCAL NETWORK" />
                        <TextBlock Margin="0,3,0,0" FontSize="34" FontWeight="Bold" Text="Devices" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource SemiColorText2}"
                            Text="Discover a supported CPE and inspect radio health without changing its configuration." />
                    </StackPanel>

                    <Border Padding="20" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Find Ubiquiti devices" />
                            <TextBlock Foreground="{DynamicResource SemiColorText2}" Text="Discovery stays on your local network." />
                            <Button
                                x:Name="DiscoveryButton"
                                HorizontalAlignment="Left"
                                Click="DiscoverDevices"
                                Content="Discover devices" />
                            <TextBlock x:Name="DiscoveryStatus" TextWrapping="Wrap" Text="Not scanned." />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Connect to airOS" />
                            <TextBlock
                                Foreground="{DynamicResource SemiColorText2}"
                                Text="Credentials stay in memory and are not saved." />

                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Device address" />
                                    <TextBox x:Name="AirOsHost" Text="http://192.168.1.20" Watermark="192.168.1.20" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Username" />
                                    <TextBox x:Name="AirOsUser" Text="ubnt" />
                                </StackPanel>
                            </Grid>

                            <StackPanel>
                                <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Password" />
                                <TextBox x:Name="AirOsPassword" PasswordChar="●" />
                            </StackPanel>

                            <CheckBox
                                x:Name="AllowInvalidCertificate"
                                Content="Allow a self-signed HTTPS certificate for this connection" />
                            <Button
                                x:Name="AirOsButton"
                                HorizontalAlignment="Left"
                                Click="ReadAirOs"
                                Content="Read device status" />
                            <TextBlock x:Name="AirOsStatus" TextWrapping="Wrap" Text="Not connected." />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                        <Border Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="SIGNAL" />
                                <TextBlock x:Name="SignalMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="SignalQualityBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Received power" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="SNR" />
                                <TextBlock x:Name="SnrMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="SnrQualityBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Signal quality" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="ETHERNET" />
                                <TextBlock x:Name="EthernetMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Margin="0,16,0,0" FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Link speed" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Padding="16" Theme="{DynamicResource CardBorder}">
                            <StackPanel>
                                <TextBlock FontSize="11" Foreground="{DynamicResource SemiColorText2}" Text="CPU" />
                                <TextBlock x:Name="CpuMetric" Margin="0,6,0,0" FontSize="22" FontWeight="Bold" Text="—" />
                                <ProgressBar x:Name="CpuLoadBar" Margin="0,10,0,6" Height="6" Minimum="0" Maximum="100" Value="0" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Device load" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="20" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="18" FontWeight="Bold" Text="Antenna alignment" />
                            <TextBlock
                                Foreground="{DynamicResource SemiColorText2}"
                                Text="Live signal and SNR, refreshed every second." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button
                                    x:Name="AlignmentStartButton"
                                    Click="StartAlignment"
                                    Content="Start alignment" />
                                <Button
                                    x:Name="AlignmentStopButton"
                                    IsEnabled="False"
                                    Click="StopAlignment"
                                    Content="Stop" />
                            </StackPanel>
                            <TextBlock x:Name="AlignmentStatus" TextWrapping="Wrap" Text="Not running." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CalculatorsPage" IsVisible="False">
                <StackPanel Margin="18,18,28,32" Spacing="16">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SemiBlue5}" Text="RF TOOLS" />
                        <TextBlock Margin="0,3,0,0" FontSize="34" FontWeight="Bold" Text="Calculators" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource SemiColorText2}"
                            Text="Engineering tools stay separate from diagnostics." />
                    </StackPanel>

                    <Border Padding="22" MaxWidth="760" HorizontalAlignment="Left" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="Bold" Text="Free-space path loss" />
                            <TextBlock Foreground="{DynamicResource SemiColorText2}" Text="Estimate path loss from distance and frequency." />
                            <Grid ColumnDefinitions="*,12,*">
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Distance (km)" />
                                    <TextBox x:Name="DistanceKm" Text="1" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,5" FontWeight="SemiBold" Text="Frequency (MHz)" />
                                    <TextBox x:Name="FrequencyMHz" Text="5800" />
                                </StackPanel>
                            </Grid>
                            <Button HorizontalAlignment="Left" Click="CalculateFspl" Content="Calculate" />
                            <Border Padding="16" Theme="{DynamicResource CardBorder}">
                                <StackPanel>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Estimated path loss" />
                                    <TextBlock x:Name="FsplResult" Margin="0,5,0,0" FontSize="26" FontWeight="Bold" Text="—" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="HistoryPage" IsVisible="False">
                <Grid Margin="28">
                    <Border
                        Padding="30"
                        MaxWidth="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Theme="{DynamicResource CardBorder}">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock HorizontalAlignment="Center" FontSize="22" FontWeight="Bold" Text="No saved runs yet" />
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SemiColorText2}"
                                Text="Persistent history and comparisons arrive later. Export JSON reports for now." />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" IsVisible="False">
                <StackPanel Margin="18,18,28,32" Spacing="16">
                    <StackPanel>
                        <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SemiBlue5}" Text="PRIVACY &amp; BEHAVIOR" />
                        <TextBlock Margin="0,3,0,0" FontSize="34" FontWeight="Bold" Text="Settings" />
                        <TextBlock
                            Margin="0,6,0,0"
                            Foreground="{DynamicResource SemiColorText2}"
                            Text="Netsira is local-first. External measurement stays opt-in." />
                    </StackPanel>
                    <Border Padding="22" Theme="{DynamicResource CardBorder}">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="Telemetry" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="No analytics or hidden telemetry." />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="Off" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="Bold" Text="M-Lab throughput" />
                                    <TextBlock FontSize="12" Foreground="{DynamicResource SemiColorText2}" Text="Runs only after explicit consent in Diagnostics." />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold" Text="Opt-in" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
