<Window x:Class="Netsira.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Netsira"
    Width="1180"
    Height="820"
    MinWidth="900"
    MinHeight="620">

    <Grid ColumnDefinitions="240,*">
        <Border Grid.Column="0" Padding="18" Background="#0F172A">
            <Grid RowDefinitions="Auto,24,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Width="40" Height="40" CornerRadius="12" Background="#2563EB">
                        <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Foreground="White" FontSize="20" FontWeight="Bold" Text="N" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Foreground="White" FontSize="20" FontWeight="SemiBold" Text="Netsira" />
                        <TextBlock Foreground="#94A3B8" FontSize="12" Text="Network diagnostics" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button Name="DiagnosticsNavButton" MinHeight="44" HorizontalContentAlignment="Left"
                            Click="NavigateDiagnostics" Content="⌂   Diagnostics" />
                    <Button Name="DevicesNavButton" MinHeight="44" HorizontalContentAlignment="Left"
                            Click="NavigateDevices" Content="◉   Devices" />
                    <Button Name="CalculatorsNavButton" MinHeight="44" HorizontalContentAlignment="Left"
                            Click="NavigateCalculators" Content="∑   Calculators" />
                    <Button Name="HistoryNavButton" MinHeight="44" HorizontalContentAlignment="Left"
                            Click="NavigateHistory" Content="↺   History" />
                    <Button Name="SettingsNavButton" MinHeight="44" HorizontalContentAlignment="Left"
                            Click="NavigateSettings" Content="⚙   Settings" />
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <TextBlock Foreground="#94A3B8" FontSize="12" Text="Local-first" />
                    <TextBlock Foreground="#94A3B8" FontSize="12" Text="No hidden telemetry" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer Name="DiagnosticsPage" IsVisible="True">
                <StackPanel Margin="32" Spacing="18" MaxWidth="1040">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Foreground="#2563EB" FontSize="12" FontWeight="Bold" Text="NETWORK HEALTH" />
                            <TextBlock FontSize="34" FontWeight="Bold" Text="Diagnostics" />
                            <TextBlock Opacity="0.68"
                                       Text="Start with a quick check. Open advanced tests only when you need them." />
                        </StackPanel>
                        <Button Grid.Column="1" Name="ExportReportButton" IsEnabled="False"
                                MinHeight="42" Click="ExportReport" Content="Export report" />
                    </Grid>

                    <Border Padding="22" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <Grid ColumnDefinitions="*,18,320">
                            <StackPanel Spacing="10">
                                <TextBlock Name="OverallStatus" FontSize="14" FontWeight="SemiBold" Text="Not tested" />
                                <TextBlock FontSize="22" FontWeight="SemiBold"
                                           Text="Run a quick check to see what is healthy." />
                                <TextBlock Opacity="0.68" TextWrapping="Wrap"
                                           Text="Netsira checks reachability, DNS, latency and loss first, then shows the important finding before raw values." />
                            </StackPanel>

                            <Button Grid.Column="2" Name="QuickTestButton" MinHeight="74"
                                    Click="RunQuickTest" Content="Run quick check" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                        <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="INTERNET" />
                                <TextBlock Name="InternetMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Reachability / latency" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="LOSS" />
                                <TextBlock Name="LossMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Quick probes" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="DOWNLOAD" />
                                <TextBlock Name="DownloadMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Mb/s" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="STABILITY" />
                                <TextBlock Name="StabilityMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Successful probes" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="What Netsira found" />
                            <TextBlock Opacity="0.65" Text="Important findings first; raw measurements stay secondary." />
                            <TextBlock Name="QuickTestStatus" TextWrapping="Wrap" Text="No test results yet." />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="14">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="More tests" />
                            <TextBlock Opacity="0.65" Text="Use these only when the quick check is not enough." />

                            <Border Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Stability · 30 seconds" />
                                    <TextBlock Opacity="0.68" TextWrapping="Wrap"
                                               Text="Repeats reachability checks and summarizes loss, latency and jitter. If airOS is available, signal and SNR are sampled too." />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="StabilityStartButton" Click="StartStability" Content="Run stability test" />
                                        <Button Name="StabilityStopButton" Click="StopStability" IsEnabled="False" Content="Cancel" />
                                    </StackPanel>
                                    <TextBlock Name="StabilityStatus" TextWrapping="Wrap" Text="Not run yet." />
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Internet speed" />
                                    <TextBlock Opacity="0.68" TextWrapping="Wrap"
                                               Text="Optional M-Lab test for download and upload. M-Lab records measurement metadata including your public IP." />
                                    <CheckBox Name="MlabConsent"
                                              Content="I understand the M-Lab privacy notice" />
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Name="SpeedTestButton" Click="RunSpeedTest" Content="Run speed test" />
                                        <Button Name="StandardTestButton" Click="RunStandardTest" Content="Run standard test" />
                                    </StackPanel>
                                    <TextBlock Name="SpeedTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                                </StackPanel>
                            </Border>

                            <Border Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="#334155">
                                <StackPanel Spacing="10">
                                    <TextBlock FontSize="17" FontWeight="SemiBold" Text="Comprehensive" />
                                    <TextBlock Opacity="0.68" TextWrapping="Wrap"
                                               Text="Combines internet checks with airOS device status when device credentials are available." />
                                    <Button Name="ComprehensiveTestButton" HorizontalAlignment="Left"
                                            Click="RunComprehensiveTest" Content="Run comprehensive test" />
                                    <TextBlock Name="ModeTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Name="DevicesPage" IsVisible="False">
                <StackPanel Margin="32" Spacing="18" MaxWidth="920">
                    <StackPanel>
                        <TextBlock Foreground="#2563EB" FontSize="12" FontWeight="Bold" Text="LOCAL NETWORK" />
                        <TextBlock FontSize="34" FontWeight="Bold" Text="Devices" />
                        <TextBlock Opacity="0.68" Text="Find a supported CPE and see radio health visually." />
                    </StackPanel>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Find your Ubiquiti device" />
                            <TextBlock Opacity="0.65" Text="Discovery stays on your local network and never sends credentials." />
                            <Button Name="DiscoveryButton" HorizontalAlignment="Left"
                                    Click="DiscoverDevices" Content="Discover devices" />
                            <TextBlock Name="DiscoveryStatus" TextWrapping="Wrap" Text="Not scanned." />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Connect to airOS" />
                            <TextBlock Opacity="0.65" Text="Credentials stay in memory and are not saved." />

                            <TextBlock FontWeight="SemiBold" Text="Device address" />
                            <TextBlock Opacity="0.6" FontSize="12" Text="Example: 192.168.1.20" />
                            <TextBox Name="AirOsHost" Text="http://192.168.1.20" />

                            <TextBlock FontWeight="SemiBold" Text="Username" />
                            <TextBox Name="AirOsUser" Text="ubnt" />

                            <TextBlock FontWeight="SemiBold" Text="Password" />
                            <TextBox Name="AirOsPassword" PasswordChar="●" />

                            <CheckBox Name="AllowInvalidCertificate"
                                      Content="Allow a self-signed HTTPS certificate for this local connection" />
                            <Button Name="AirOsButton" HorizontalAlignment="Left"
                                    Click="ReadAirOs" Content="Read device status" />
                            <TextBlock Name="AirOsStatus" TextWrapping="Wrap" Text="Not connected." />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                        <Border Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="SIGNAL" />
                                <TextBlock Name="SignalMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Received power" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="SNR" />
                                <TextBlock Name="SnrMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Signal quality" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="4" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="ETHERNET" />
                                <TextBlock Name="EthernetMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Link speed" />
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="6" Padding="16" CornerRadius="12" BorderThickness="1" BorderBrush="#475569">
                            <StackPanel>
                                <TextBlock Opacity="0.6" FontSize="12" Text="CPU" />
                                <TextBlock Name="CpuMetric" FontSize="22" FontWeight="Bold" Text="—" />
                                <TextBlock Opacity="0.6" FontSize="12" Text="Device load" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Device findings" />
                            <TextBlock Name="DeviceFindingStatus" TextWrapping="Wrap"
                                       Text="Connect to a device to see interpreted findings." />
                        </StackPanel>
                    </Border>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Antenna alignment" />
                            <TextBlock Opacity="0.65"
                                       Text="Live signal, SNR and chain values refresh once per second." />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Name="AlignmentStartButton" Click="StartAlignment" Content="Start alignment" />
                                <Button Name="AlignmentStopButton" Click="StopAlignment" IsEnabled="False" Content="Stop" />
                            </StackPanel>
                            <TextBlock Name="AlignmentStatus" TextWrapping="Wrap" Text="Not running." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Name="CalculatorsPage" IsVisible="False">
                <StackPanel Margin="32" Spacing="18" MaxWidth="760">
                    <StackPanel>
                        <TextBlock Foreground="#2563EB" FontSize="12" FontWeight="Bold" Text="RF TOOLS" />
                        <TextBlock FontSize="34" FontWeight="Bold" Text="Calculators" />
                        <TextBlock Opacity="0.68" Text="Engineering tools stay separate from diagnostics." />
                    </StackPanel>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="12">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Free-space path loss" />
                            <TextBlock Opacity="0.65" Text="Estimate path loss from distance and frequency." />

                            <TextBlock FontWeight="SemiBold" Text="Distance (km)" />
                            <TextBox Name="DistanceKm" Text="1" />

                            <TextBlock FontWeight="SemiBold" Text="Frequency (MHz)" />
                            <TextBox Name="FrequencyMHz" Text="5800" />

                            <Button HorizontalAlignment="Left" Click="CalculateFspl" Content="Calculate" />

                            <Border Padding="16" CornerRadius="10" Background="#172554">
                                <StackPanel>
                                    <TextBlock Foreground="#93C5FD" FontSize="12" Text="ESTIMATED PATH LOSS" />
                                    <TextBlock Name="FsplResult" Foreground="White" FontSize="28" FontWeight="Bold" Text="—" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer Name="HistoryPage" IsVisible="False">
                <Grid MinHeight="500">
                    <Border Padding="28" CornerRadius="14" BorderThickness="1" BorderBrush="#475569"
                            HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                        <StackPanel Spacing="8" HorizontalAlignment="Center">
                            <TextBlock FontSize="28" HorizontalAlignment="Center" Text="↺" />
                            <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Text="No saved runs yet" />
                            <TextBlock TextAlignment="Center" Opacity="0.65" TextWrapping="Wrap"
                                       Text="Persistent history and comparisons arrive in the product-polish phase. Export JSON reports for now." />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ScrollViewer Name="SettingsPage" IsVisible="False">
                <StackPanel Margin="32" Spacing="18" MaxWidth="760">
                    <StackPanel>
                        <TextBlock Foreground="#2563EB" FontSize="12" FontWeight="Bold" Text="PRIVACY &amp; BEHAVIOR" />
                        <TextBlock FontSize="34" FontWeight="Bold" Text="Settings" />
                        <TextBlock Opacity="0.68" Text="Netsira is local-first. External measurement is opt-in." />
                    </StackPanel>

                    <Border Padding="20" CornerRadius="14" BorderThickness="1" BorderBrush="#475569">
                        <StackPanel Spacing="14">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Telemetry" />
                                    <TextBlock Opacity="0.65" Text="No analytics or hidden telemetry." />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="#22C55E" FontWeight="SemiBold" Text="Off" />
                            </Grid>
                            <Separator />
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold" Text="Measurement Lab" />
                                    <TextBlock Opacity="0.65" Text="Runs only after explicit consent in Diagnostics." />
                                </StackPanel>
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontWeight="SemiBold" Text="Opt-in" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
