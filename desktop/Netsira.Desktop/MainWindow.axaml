<Window
    x:Class="Netsira.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Netsira"
    Width="1100"
    Height="720"
    MinWidth="820"
    MinHeight="560">
    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0" Padding="20" Background="#111827">
            <Grid RowDefinitions="Auto,24,*">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="Netsira" />
                    <TextBlock Margin="0,4,0,0" Foreground="#CBD5E1" Text="Network diagnostics" />
                </StackPanel>

                <StackPanel Grid.Row="2" Spacing="6">
                    <Button HorizontalContentAlignment="Left" Content="Diagnostics" />
                    <Button HorizontalContentAlignment="Left" Content="Devices" />
                    <Button HorizontalContentAlignment="Left" Content="Calculators" />
                    <Button HorizontalContentAlignment="Left" Content="History" />
                    <Button HorizontalContentAlignment="Left" Content="Settings" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="32" RowDefinitions="Auto,24,*">
            <StackPanel>
                <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diagnostics" />
                <TextBlock Margin="0,6,0,0" Opacity="0.65"
                           Text="Choose a test. Netsira will use only the capabilities available on this device." />
            </StackPanel>

            <Grid Grid.Row="2" ColumnDefinitions="*,16,*">
                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Quick test" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="A short health snapshot of the local path and internet reachability." />
                        <Button HorizontalAlignment="Left" IsEnabled="False" Content="Coming in Phase 2" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="10">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Comprehensive test" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="Runs every supported diagnostic stage and correlates the evidence." />
                        <Button HorizontalAlignment="Left" IsEnabled="False" Content="Coming in Phase 2" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
