<Window x:Class="Netsira.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Netsira" Width="1120" Height="800" MinWidth="860" MinHeight="600">
    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0" Padding="20" Background="#111827">
            <Grid RowDefinitions="Auto,24,*">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="Netsira" />
                    <TextBlock Margin="0,4,0,0" Foreground="#CBD5E1" Text="Network diagnostics" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="6">
                    <Button HorizontalContentAlignment="Left" Content="Diagnostics" />
                    <Button HorizontalContentAlignment="Left" Content="Devices" />
                    <Button HorizontalContentAlignment="Left" Content="Calculators" />
                    <Button HorizontalContentAlignment="Left" Content="History" />
                    <Button HorizontalContentAlignment="Left" Content="Settings" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="32" Spacing="20">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diagnostics" />
                        <TextBlock Margin="0,6,0,0" Opacity="0.65" Text="Local checks, CPE status, public throughput, and RF calculators." />
                    </StackPanel>
                    <Button Grid.Column="1" Name="ExportReportButton" IsEnabled="False" Click="ExportReport" Content="Export report" />
                </Grid>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Test modes" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="Standard and comprehensive tests include M-Lab NDT7 throughput measurement." />
                        <CheckBox Name="MlabConsent" Content="I understand that M-Lab records measurement metadata including my public IP address" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="StandardTestButton" Click="RunStandardTest" Content="Run standard test" />
                            <Button Name="ComprehensiveTestButton" Click="RunComprehensiveTest" Content="Run comprehensive test" />
                        </StackPanel>
                        <TextBlock Name="ModeTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Quick test" />
                        <Button Name="QuickTestButton" HorizontalAlignment="Left" Click="RunQuickTest" Content="Run quick test" />
                        <TextBlock Name="QuickTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="airOS device status" />
                        <TextBlock Opacity="0.75" TextWrapping="Wrap" Text="Read-only. Credentials stay in memory and are not saved." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="DiscoveryButton" Click="DiscoverDevices" Content="Discover Ubiquiti devices" />
                            <TextBlock Name="DiscoveryStatus" VerticalAlignment="Center" Text="Not scanned." />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto">
                            <TextBox Name="AirOsHost" Watermark="Device URL or IP" Text="http://192.168.1.20" />
                            <TextBox Grid.Column="2" Name="AirOsUser" Watermark="Username" Text="ubnt" />
                            <TextBox Grid.Row="2" Grid.ColumnSpan="3" Name="AirOsPassword" Watermark="Password" PasswordChar="●" />
                            <CheckBox Grid.Row="4" Grid.ColumnSpan="3" Name="AllowInvalidCertificate" Content="Allow self-signed HTTPS certificate for this connection" />
                            <Button Grid.Row="6" Grid.ColumnSpan="3" HorizontalAlignment="Left" Name="AirOsButton" Click="ReadAirOs" Content="Read device status" />
                        </Grid>
                        <TextBlock Name="AirOsStatus" TextWrapping="Wrap" Text="Not connected." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Antenna alignment" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="Uses one authenticated airOS session and refreshes signal, SNR and chain values once per second." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="AlignmentStartButton" Click="StartAlignment" Content="Start alignment" />
                            <Button Name="AlignmentStopButton" Click="StopAlignment" IsEnabled="False" Content="Stop" />
                        </StackPanel>
                        <TextBlock Name="AlignmentStatus" TextWrapping="Wrap" Text="Not running." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Stability monitor" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="Runs repeated TCP reachability for 30 seconds and also samples airOS signal/SNR when device credentials are available." />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="StabilityStartButton" Click="StartStability" Content="Run 30-second stability test" />
                            <Button Name="StabilityStopButton" Click="StopStability" IsEnabled="False" Content="Cancel" />
                        </StackPanel>
                        <TextBlock Name="StabilityStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Internet throughput (M-Lab NDT7)" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75" Text="Optional. Measurement Lab records measurement metadata including your public IP address." />
                        <Button Name="SpeedTestButton" HorizontalAlignment="Left" Click="RunSpeedTest" Content="Run download + upload test" />
                        <TextBlock Name="SpeedTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="FSPL calculator" />
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <TextBox Name="DistanceKm" Watermark="Distance (km)" Text="1" />
                            <TextBox Grid.Column="2" Name="FrequencyMHz" Watermark="Frequency (MHz)" Text="5800" />
                            <Button Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Left" Click="CalculateFspl" Content="Calculate FSPL" />
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Name="FsplResult" Text="Result: —" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
