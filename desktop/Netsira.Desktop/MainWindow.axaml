<Window x:Class="Netsira.Desktop.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Netsira" Width="1100" Height="760" MinWidth="820" MinHeight="560">
    <Grid ColumnDefinitions="220,*">
        <Border Grid.Column="0" Padding="20" Background="#111827">
            <Grid RowDefinitions="Auto,24,*">
                <StackPanel>
                    <TextBlock Foreground="White" FontSize="24" FontWeight="SemiBold" Text="Netsira" />
                    <TextBlock Margin="0,4,0,0" Foreground="#CBD5E1" Text="Network diagnostics" />
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="6">
                    <Button HorizontalContentAlignment="Left" Content="Diagnostics" />
                    <Button HorizontalContentAlignment="Left" Content="Devices" />
                    <Button HorizontalContentAlignment="Left" Content="Calculators" />
                    <Button HorizontalContentAlignment="Left" Content="History" />
                    <Button HorizontalContentAlignment="Left" Content="Settings" />
                </StackPanel>
            </Grid>
        </Border>
        <ScrollViewer Grid.Column="1">
            <StackPanel Margin="32" Spacing="20">
                <StackPanel>
                    <TextBlock FontSize="28" FontWeight="SemiBold" Text="Diagnostics" />
                    <TextBlock Margin="0,6,0,0" Opacity="0.65" Text="Quick local checks, public throughput, and RF calculators." />
                </StackPanel>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Quick test" />
                        <Button Name="QuickTestButton" HorizontalAlignment="Left" Click="RunQuickTest" Content="Run quick test" />
                        <TextBlock Name="QuickTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Internet throughput (M-Lab NDT7)" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.75"
                                   Text="This optional test sends measurement traffic to Measurement Lab. M-Lab records measurement metadata including your public IP address." />
                        <Button Name="SpeedTestButton" HorizontalAlignment="Left" Click="RunSpeedTest" Content="Run download + upload test" />
                        <TextBlock Name="SpeedTestStatus" TextWrapping="Wrap" Text="Not run yet." />
                    </StackPanel>
                </Border>

                <Border Padding="20" CornerRadius="10" BorderThickness="1" BorderBrush="#CBD5E1">
                    <StackPanel Spacing="12">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="FSPL calculator" />
                        <Grid ColumnDefinitions="*,12,*" RowDefinitions="Auto,12,Auto,12,Auto">
                            <TextBox Name="DistanceKm" Watermark="Distance (km)" Text="1" />
                            <TextBox Grid.Column="2" Name="FrequencyMHz" Watermark="Frequency (MHz)" Text="5800" />
                            <Button Grid.Row="2" Grid.ColumnSpan="3" HorizontalAlignment="Left" Click="CalculateFspl" Content="Calculate FSPL" />
                            <TextBlock Grid.Row="4" Grid.ColumnSpan="3" Name="FsplResult" Text="Result: —" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
