{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netsira.dev/spec/diagnostics/report.schema.json",
  "title": "Netsira diagnostic report",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "platform",
    "startedAt",
    "stages",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "quick",
        "standard",
        "comprehensive",
        "stability",
        "alignment",
        "lan",
        "internet"
      ]
    },
    "platform": {
      "enum": [
        "android",
        "windows",
        "linux",
        "web",
        "ios"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "stages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/stage"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean",
          "null"
        ]
      }
    }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": [
        "id",
        "status",
        "metrics"
      ],
      "properties": {
        "id": {
          "enum": [
            "device",
            "lan",
            "router",
            "cpe",
            "wireless",
            "isp",
            "internet"
          ]
        },
        "status": {
          "enum": [
            "ok",
            "info",
            "warning",
            "problem",
            "unknown",
            "skipped"
          ]
        },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "boolean",
              "null"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": [
        "code",
        "severity",
        "title",
        "evidence"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z0-9_]+$"
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "problem"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "detail": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
